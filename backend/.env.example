# 后端环境变量示例
# 请复制该文件为 .env 并填写真实值

# 阿里云百炼接口密钥
DASHSCOPE_API_KEY=your-dashscope-api-key

# Flask 运行端口
PORT=5000

# Railway MySQL 数据库配置
# 使用私有网络（推荐，用于Railway内部服务连接）
DATABASE_URL=mysql+pymysql://username:password@mysql.railway.internal:3306/database_name
# 示例: mysql+pymysql://root:password@mysql.railway.internal:3306/railway

# 如果需要从本地开发环境连接，使用公网地址
# DATABASE_URL=mysql+pymysql://username:password@yamabiko.proxy.rlwy.net:17973/database_name