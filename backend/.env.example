# 后端环境变量示例
# 请复制该文件为 .env 并填写真实值

# 阿里云百炼接口密钥
DASHSCOPE_API_KEY=your-dashscope-api-key

# Flask 运行端口
PORT=5000

# ==================== 数据库配置 ====================
# 
# 重要提示：
# 1. 如果后端和数据库在同一个Railway项目中，使用私有网络（推荐）
# 2. 如果后端和数据库在不同的Railway项目中，必须使用公网地址
# 3. 可以配置主数据库和备用数据库，系统会自动尝试连接
#
# ==================== 场景1: 后端和数据库在同一Railway项目 ====================
# 使用私有网络（推荐，更快更安全）
DATABASE_URL=mysql+pymysql://username:password@mysql.railway.internal:3306/database_name
# 示例: mysql+pymysql://root:password@mysql.railway.internal:3306/railway

# ==================== 场景2: 后端和数据库在不同Railway项目 ====================
# 使用公网地址（必须）
DATABASE_URL=mysql+pymysql://username:password@yamabiko.proxy.rlwy.net:17973/database_name
# 示例: mysql+pymysql://root:password@yamabiko.proxy.rlwy.net:17973/railway

# ==================== 备用数据库配置（可选） ====================
# 当主数据库不可用时，系统会自动尝试连接备用数据库
# DATABASE_URL_BACKUP=mysql+pymysql://username:password@backup-host:port/database_name

# ==================== 本地开发环境 ====================
# 选项A: 连接到 Railway MySQL（使用公网）
# DATABASE_URL=mysql+pymysql://username:password@yamabiko.proxy.rlwy.net:17973/database_name

# 选项B: 使用本地 SQLite（推荐用于本地开发）
# 不设置 DATABASE_URL，会自动使用 SQLite
# DATABASE_URL=